  <header class="cabecera" id="inicio">
    <div class="patron-portada" aria-hidden="true"></div>
    <nav class="navegacion" aria-label="Navegación principal">
      <a class="marca marca-institucional" href="index.html" aria-label="Ir al Repositorio Accesible">
        <img class="marca-logo-superior" src="https://crebeucayali.github.io/banco-digital-accesible/logo-crebe.png" alt="Logo del CREBE Señor de los Milagros - Ucayali">
